logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage output
coverage/
.nyc_output/

# Build / cache
dist/
build/
.cache/
tmp/
temp/

# Database dumps
*.sql.gz
*.dump

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
