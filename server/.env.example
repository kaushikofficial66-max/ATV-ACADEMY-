PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_db
DB_USER=root
DB_PASSWORD=

# Required in production (long random string)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS allow-list; never "*").
# The first is used in email links. Production: https://learn.antarikshtv.com
# The WooCommerce webhook is server-to-server and needs no CORS entry.
FRONTEND_URL=http://localhost:3000

# Public URL of this API, used in emailed links (e.g. the email verification link).
# Leave empty to use the host the request came in on (fine for local development);
# set it in production, e.g. https://api.atvacademy.com
API_URL=

# Optional: after clicking the verification link, redirect to this frontend page
# with ?status=verified|already_verified|expired|invalid. Empty = the API shows
# its own confirmation page.
EMAIL_VERIFICATION_REDIRECT_URL=

# --- Integrations -----------------------------------------------------------
# All of these can also be set (and later changed) in Admin > Settings; values
# saved there take precedence over this file.

# SMTP (forgot password, verification, admin emails)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=ATV Academy
MAIL_FROM_ADDRESS=

# WooCommerce store (antarikshtv.com) - the commerce source of truth.
# WOOCOMMERCE_ENABLED=true: paid courses are bought on the store; LMS cart, coupons
# and Razorpay checkout are closed (free courses still enroll here).
# Webhooks (WooCommerce > Settings > Advanced > Webhooks, API v3, one webhook per topic:
# Order created / Order updated / Order deleted / Order restored / Product updated / Product deleted):
#   Delivery URL: https://<api-host>/api/v1/webhooks/woocommerce   Secret: WOOCOMMERCE_WEBHOOK_SECRET
# REST API keys (WooCommerce > Settings > Advanced > REST API, permission "Read/Write"):
# creating a paid course creates a draft store product; also used for price/status sync,
# reconciliation of missed webhooks, partial refunds and admin "Resync".
# Existing products can still be linked by hand: Admin > Courses > (course) > WooCommerce product ID.
WOOCOMMERCE_ENABLED=false
WOOCOMMERCE_URL=https://antarikshtv.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
# Shared secret for the antarikshtv.com checkout -> POST /api/v1/webhooks/atv-site
# (header X-ATV-Signature = hex HMAC-SHA256 of the raw body). Same value goes in the website plugin.
ATV_SITE_WEBHOOK_SECRET=
# Order statuses that grant course access
WOOCOMMERCE_PAID_STATUSES=processing,completed
# Create a draft WooCommerce product when a paid course is created
WOOCOMMERCE_AUTO_CREATE_PRODUCTS=true

# Razorpay (legacy LMS checkout, used only while WOOCOMMERCE_ENABLED=false).
# Webhook URL: https://<api-host>/api/v1/webhooks/razorpay
# events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Zoom Server-to-Server OAuth app (scopes: meeting:write, meeting:read)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=me

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Storage. auto = Vimeo (videos) / Cloudflare R2 (files) when configured,
# otherwise this server's disk | cloud = Vimeo + R2 only (uploads fail if
# not configured) | local = disk only (development)
STORAGE_DRIVER=auto

# Vimeo - recorded videos. Vimeo developer app > Generate access token with
# scopes: public private create edit delete upload video_files
VIMEO_ACCESS_TOKEN=
# Optional Vimeo folder (project) id to keep course videos together
VIMEO_FOLDER_ID=
# disable = hidden on vimeo.com, embed-only (recommended) | unlisted | nobody | anybody
VIMEO_PRIVACY_VIEW=disable
# Domains allowed to embed the player, comma-separated (e.g. atvacademy.com,localhost).
# Empty = embeddable anywhere. Requires a paid Vimeo plan.
VIMEO_EMBED_DOMAINS=
# true = also return time-limited HLS/MP4 links for a custom player (plan with file access)
VIMEO_USE_DIRECT_LINKS=false

# Cloudflare R2 - documents, project files, images, reports (R2 > Manage API tokens).
# CLOUDFLARE_R2_PUBLIC_URL: public bucket URL or custom domain used for images
# (e.g. https://media.atvacademy.com). Without it images stay on local disk.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# --- Optional ---------------------------------------------------------------
MAX_VIDEO_SIZE_MB=2048
API_RATE_LIMIT=2000
AUTH_RATE_LIMIT=20
DISABLE_SCHEDULER=false

# Used once by `npm run seed` to create the first admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
