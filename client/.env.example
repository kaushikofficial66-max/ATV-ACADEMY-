# Backend API (ATV Academy server). Used in the browser and on the Next.js server.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Socket.io server for real-time notifications (usually the API host)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Public URL of this website (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ATV Academy

# Where courses are bought (shown only in empty-state hints)
NEXT_PUBLIC_STORE_URL=https://antarikshtv.com
# Logo shown in the headers (defaults to the antarikshtv.com logo; leave empty for a text logo)
# NEXT_PUBLIC_LOGO_URL=
